{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend"
      },
      "configurations": {
        "local": {
          "command": "docker compose -p ai-calling-platform -f compose.local.yml up -d"
        }
      },
      "defaultConfiguration": "local"
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend"
      },
      "configurations": {
        "local": {
          "command": "docker compose -p ai-calling-platform -f compose.local.yml down"
        }
      },
      "defaultConfiguration": "local"
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend"
      },
      "configurations": {
        "local": {
          "command": "docker compose -p ai-calling-platform -f compose.local.yml down -v"
        }
      },
      "defaultConfiguration": "local"
    },
    "hasura-console": {
      "executor": "nx:run-commands",
      "options": {
        "command": "hasura console --project apps/backend/hasura"
      }
    },
    "hasura-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "hasura migrate apply --project apps/backend/hasura --database-name default"
      }
    },
    "hasura-metadata-apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "hasura metadata apply --project apps/backend/hasura"
      }
    },
    "hasura-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "hasura migrate status --project apps/backend/hasura --database-name default"
      }
    }
  },
  "tags": []
}
