# Zitadel Cloud OIDC config for the web app (PKCE public client)
# Get these from https://zitadel.cloud -> your instance -> Projects -> your project -> Applications

# e.g. https://your-instance-xxxxx.zitadel.cloud
VITE_ZITADEL_AUTHORITY=https://your-instance-xxxxx.zitadel.cloud

VITE_ZITADEL_CLIENT_ID=your-web-app-client-id

VITE_ZITADEL_REDIRECT_URI=http://localhost:4200/callback
VITE_ZITADEL_POST_LOGOUT_REDIRECT_URI=http://localhost:4200

# Express REST API (calls, auth bootstrap, /me)
VITE_API_BASE_URL=http://localhost:3000

# Hasura GraphQL Engine (queries, mutations, subscriptions)
VITE_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
VITE_HASURA_WS_URL=ws://localhost:8080/v1/graphql
