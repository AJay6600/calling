generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  zitadelOrgId String   @unique
  bolnaApiKey  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}