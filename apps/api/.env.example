# Zitadel Cloud config used server-side to verify access tokens via JWKS
# Get this from https://zitadel.cloud -> your instance -> Projects -> your project -> Applications

# e.g. https://your-instance-xxxxx.zitadel.cloud
ZITADEL_ISSUER=https://your-instance-xxxxx.zitadel.cloud

# The client ID of the web app - used to validate the token's audience claim
ZITADEL_AUDIENCE=your-web-app-client-id
